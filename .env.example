# Copy this file to .env and fill it in. Never commit .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
BUFFER_API_KEY=
# Find it with:  python -m cdaily channels
BUFFER_CHANNEL_ID=
# Public address of the output folder. Buffer downloads the images and video from here.
# With the GitHub workflow this is set for you. Example for a public repo:
# https://raw.githubusercontent.com/<user>/circassian_daily/main/output
MEDIA_BASE_URL=
TIMEZONE=Asia/Amman
# Leave empty to post as soon as the run finishes, or set HH:MM to schedule it for later the same day.
POST_TIME=
REEL_SECONDS_PER_SLIDE=3.5
